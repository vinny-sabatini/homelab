
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends":[
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "major": {
    "enabled": true
  },
  "enabledManagers": [
    "argocd", "custom.regex"
  ],
  "argocd": {
    "managerFilePatterns": [
      "applications/*"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.*Upgrade.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)\n\\s*version: (?<currentValue>.*?)\n"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": [
        "argocd"
      ],
      "matchFileNames": [
        "applications/tuppr.yaml"
      ],
      "overridePackageName": "ghcr.io/home-operations/charts/tuppr"
    },
    {
      "matchManagers": [
        "argocd"
      ],
      "matchFileNames": [
        "applications/kepler.yaml"
      ],
      "overridePackageName": "quay.io/sustainable_computing_io/charts/kepler"
    },
    {
      "matchManagers": [
        "argocd"
      ],
      "matchFileNames": [
        "applications/obico.yaml"
      ],
      "overridePackageName": "ghcr.io/gabe565/charts/obico"
    },
    {
      "matchManagers": [
        "argocd"
      ],
      "matchFileNames": [
        "applications/renovate-operator.yaml"
      ],
      "overridePackageName": "ghcr.io/mogenius/helm-charts/renovate-operator"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/siderolabs/installer", "ghcr.io/siderolabs/kubelet"],
      "separateMajorMinor": true,
      "separateMinorPatch": true
    }
  ]
}
